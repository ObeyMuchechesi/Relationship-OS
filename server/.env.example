PORT=5000
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/relationship-os?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# TMDB (movie catalog + where-to-watch) — keys stay server-side only.
TMDB_READ_TOKEN=
TMDB_API_KEY=

# Optional: YouTube Data API v3 key — lets the movie picker find full-length
# free/ad-supported copies (Google Cloud Console → YouTube Data API v3 →
# Credentials). Without it, movies fall back to trailers + watch links.
YOUTUBE_API_KEY=

# TMDB movie catalog (server-side only — never expose these to the client).
TMDB_API_KEY=your_tmdb_v3_api_key
TMDB_READ_TOKEN=your_tmdb_v4_read_access_token
